APP_NAME="Restaurant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://restaurant.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurantnew
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@restaurant.test"
MAIL_FROM_NAME="${APP_NAME}"

# Chatbot (tùy chọn) - KHÔNG commit key thật lên Git
GEMINI_API_KEY=
